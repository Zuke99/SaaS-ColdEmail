# ============================================
# APP IDENTITY — change these for each SaaS
# ============================================

# Unique identifier for this SaaS (lowercase, underscores only)
# Used as the Postgres schema name e.g. youtube_toolkit
NEXT_PUBLIC_APP_ID=youtube_toolkit

# Human-readable app name shown in emails and UI
NEXT_PUBLIC_APP_NAME=YouTube Toolkit

# Full URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: URL of your app logo (used in emails)
NEXT_PUBLIC_APP_LOGO_URL=

# ============================================
# FEATURE FLAGS
# Turn features on/off for this SaaS product
# true = enabled, false = disabled
# ============================================

ENABLE_PAYMENTS=false
ENABLE_EMAIL=false
ENABLE_BLOG=true
ENABLE_ANALYTICS=false

# Rules:
# - Set a feature to true ONLY when you have its env vars filled in below
# - Blog is ON by default — set ENABLE_BLOG=false to disable
# - Auth and Database are always on and cannot be disabled

# ============================================
# SUPABASE
# ============================================

# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Found in: Supabase Dashboard → Settings → API → service_role
# WARNING: Never prefix with NEXT_PUBLIC_ — server only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# DODO PAYMENTS (required when ENABLE_PAYMENTS=true)
# ============================================

# Found in: Dodo Dashboard → API Keys
DODO_PAYMENTS_API_KEY=your_api_key

# Found in: Dodo Dashboard → Webhooks → your endpoint → secret
DODO_PAYMENTS_WEBHOOK_KEY=your_webhook_secret

# Use test_mode for development, live_mode for production
DODO_PAYMENTS_ENVIRONMENT=test_mode

# The URL Dodo redirects to after successful payment
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# Found in: Dodo Dashboard → Products → your Pro product → ID
DODO_PRO_PRODUCT_ID=your_product_id

# ============================================
# RESEND (EMAIL — required when ENABLE_EMAIL=true)
# ============================================

# Found in: Resend Dashboard → API Keys
RESEND_API_KEY=your_resend_api_key

# The from address — must match a verified domain in Resend
EMAIL_FROM=noreply@yourdomain.com

# Reply-to address for support emails
EMAIL_REPLY_TO=support@yourdomain.com

# ============================================
# ANALYTICS (required when ENABLE_ANALYTICS=true)
# ============================================

POSTHOG_API_KEY=
